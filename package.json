{
  "name": "doomsday-harem",
  "private": true,
  "version": "0.15.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --test packages/core/test/*.test.ts packages/llm/test/*.test.ts",
    "test:core": "node --test packages/core/test/*.test.ts",
    "test:llm": "node --test packages/llm/test/*.test.ts",
    "demo": "node packages/core/demo.ts",
    "typecheck": "tsc -p tsconfig.json",
    "version": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs --check",
    "dev": "pnpm --filter @doomsday/desktop dev",
    "build": "pnpm --filter @doomsday/desktop build",
    "tauri": "pnpm --filter @doomsday/desktop tauri",
    "smoke:ollama": "node scripts/ollama-smoke.mjs",
    "gen": "node scripts/gen-scripts.mjs",
    "prebuild": "node scripts/gen-scripts.mjs",
    "predev": "node scripts/gen-scripts.mjs",
    "demo:session": "node packages/core/demo-session.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.8.3"
  }
}
