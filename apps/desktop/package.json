    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "@doomsday/core": "workspace:*",
    "@doomsday/llm": "workspace:*",
    "react": "^18.3.1",
