{
  "name": "@doomsday/desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron . --dev",
    "build:electron": "vite build",
    "dist": "electron-builder --win && powershell -ExecutionPolicy Bypass -File ../../scripts/sign-electron.ps1",
    "dist:dir": "electron-builder --win --dir && powershell -ExecutionPolicy Bypass -File ../../scripts/sign-electron.ps1",
    "dist:portable": "electron-builder --win portable && powershell -ExecutionPolicy Bypass -File ../../scripts/sign-electron.ps1",
    "sign": "powershell -ExecutionPolicy Bypass -File ../../scripts/sign-electron.ps1"
  },
  "devDependencies": {
    "@doomsday/core": "workspace:*",
    "@doomsday/llm": "workspace:*",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.0",
    "cross-env": "^10.1.0",
    "electron": "^41.1.1",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "zustand": "^5.0.0"
  },
  "main": "electron/main.cjs",
  "description": "Doomsday Harem - post-apocalyptic survival management game",
  "author": {
    "name": "RanMiao",
    "email": "ranmiao@local"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Anarrogantcat/doomsday-harem.git"
  }
}