{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doomsday Harem",
  "version": "0.57.0",
  "identifier": "com.doomsdayharem.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Doomsday Harem",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "zlib",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Doomsday Harem",
        "installerHooks": "nsis-hooks.nsh"
      }
    },
    "publisher": "Doomsday Harem Studio",
    "copyright": "Copyright (C) 2026 Doomsday Harem Studio",
    "category": "Game",
    "shortDescription": "末日生存后宫沙盒",
    "longDescription": "末日生存 + 科技树 + 后宫管理的文字沙盒游戏。包含基地建造、房车改装、探索、战斗、关系养成与剧情生成。"
  }
}
